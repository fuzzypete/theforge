#!/usr/bin/env python3
"""Fake claude CLI for runner lifecycle subprocess tests.

Controlled via FAKE_CLAUDE_MODE environment variable:
  happy       — read initial prompt, emit result event, exit 0 (default)
  wait_stdin  — emit result event then block on stdin WITHOUT closing stdout.
                Stdout stays open; the runner's for-loop can only exit once it
                breaks on the result event (new behaviour) or the watchdog kills
                (old behaviour). Tests that the runner's break-on-result path
                fires before the watchdog so the subprocess exits cleanly.
  hang        — read initial prompt, emit nothing, sleep for up to 30s.
                Capped to avoid gate hangs if the watchdog ever regresses.
  nudge       — emit two identical tool-call iterations to trigger stuck-
                detection nudge, then read the nudge from stdin and respond
                with a result event (nudge delivery test)
  usage_then_hang
              — emit assistant events carrying per-message ``usage`` blocks and
                then hang, so the runner is killed at its watchdog and has to
                reconstruct spend from the stream it already saw. Exercises the
                kill-path cost reconstruction, whose cost is a forge pricing-
                table derivation rather than a figure the CLI reported (#2205).
  grandchild_hang
              — spawn a long-sleeping grandchild (same process group), write
                its PID to $FAKE_GRANDCHILD_PID_FILE, then emit nothing and
                hang so the runner's timeout/stop path fires. Proves the group
                kill reaches grandchildren, not just the direct child.
  grandchild_stream
              — like grandchild_hang but emit one non-result line first so the
                runner's stream loop runs at least once; lets a test raise an
                exception mid-stream to exercise the except-BaseException kill.
  grandchild_success
              — spawn a long-sleeping grandchild (same process group), write its
                PID to $FAKE_GRANDCHILD_PID_FILE, emit a normal result event and
                exit 0. The agent's own run succeeded; what it started did not
                stop. Nothing here is a timeout or an error, so only a teardown
                that checks the group on a CLEAN exit reaps the grandchild
                (#2309).
  escapee_success
              — like grandchild_success, but the grandchild starts its OWN
                session (start_new_session, i.e. setsid), so it leaves the
                spawned process group entirely. No pgid-based teardown can see
                it; only descendant observation or the inherited lease token
                can (#2309).
  unreadable_escapee_success
              — the hardest shape: a SIP-protected platform binary (/bin/sleep)
                given an EMPTY environment and its own session, then a normal
                successful exit. Not in the group, and carrying no readable
                token — so only descendant observation can find it (#2309).
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time

MODE = os.environ.get("FAKE_CLAUDE_MODE", "happy")

_RESULT_EVENT = {
    "type": "result",
    "result": "Task complete.",
    "session_id": "fake-session-abc123",
    "total_cost_usd": 0.001,
    "is_error": False,
}

_TOOL_CALL = {
    "type": "tool_use",
    "id": "t1",
    "name": "Bash",
    "input": {"command": "echo loop"},
}

_TOOL_RESULT_ITEM = {
    "type": "tool_result",
    "tool_use_id": "t1",
    "content": "loop",
}


def _emit(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def _read_user_msg() -> str | None:
    """Read and return the content of the next user message from stdin, or None on EOF."""
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except Exception:
            continue
        if msg.get("type") == "user":
            return str(msg.get("message", {}).get("content", ""))
    return None


def _emit_tool_iteration() -> None:
    """Emit one assistant tool-use + user tool-result pair (identical each call)."""
    _emit({"type": "assistant", "message": {"role": "assistant", "content": [_TOOL_CALL]}})
    _emit({"type": "user", "message": {"role": "user", "content": [_TOOL_RESULT_ITEM]}})


def _spawn_grandchild_and_hang(*, stream_first: bool = False) -> None:
    """Spawn a sleeping grandchild in this process group, record its PID, hang.

    The grandchild inherits this process's group (no start_new_session), so a
    group kill must reach it. A bare kill of the direct child (this fake CLI)
    would leave the grandchild alive — exactly the leak the fix closes.

    When ``stream_first`` is set, emit one non-result assistant line before
    hanging so the runner's stream loop body runs at least once (lets a test
    inject an exception mid-stream to exercise the except-BaseException path).
    """
    _read_user_msg()
    _spawn_grandchild()
    if stream_first:
        _emit({"type": "assistant", "message": {"role": "assistant", "content": []}})
        sys.stdout.flush()
    # Emit nothing further and hang so the runner's teardown path fires.
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        time.sleep(0.1)
    sys.exit(0)


def _spawn_grandchild(detach_io: bool = False, own_session: bool = False) -> None:
    """Spawn a sleeping grandchild in this process group and record its PID.

    ``detach_io`` closes the grandchild off from our stdout/stderr, which the
    clean-exit mode needs: a grandchild holding the runner's capture pipe keeps
    it reading past the CLI's own exit, which would turn a clean-exit test into
    a timeout test and prove nothing about #2309.

    ``own_session`` makes it leave the process group (setsid), the way a test
    runner or a daemonising helper does — the escape a pgid cannot describe.
    """
    io = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL} if detach_io else {}
    grandchild = subprocess.Popen(
        [sys.executable, "-c", "import time; time.sleep(30)"],
        start_new_session=own_session,
        **io,
    )
    pidfile = os.environ.get("FAKE_GRANDCHILD_PID_FILE")
    if pidfile:
        with open(pidfile, "w") as fh:
            fh.write(str(grandchild.pid))
    if own_session:
        # An escapee is only findable by the two mechanisms that survive setsid,
        # and one of them (descendant observation) needs the CLI to still be
        # alive when it samples. Keeping working for a moment is what a dev agent
        # that kicked off a test run does; spawning and exiting in the same
        # millisecond would test a race the OS itself cannot close on macOS.
        time.sleep(0.4)


def _spawn_unreadable_escapee() -> None:
    """Spawn a descendant that no environment token can ever find.

    Two hardenings at once, both of them ordinary rather than adversarial:
    ``/bin/sleep`` is a SIP-protected platform binary, whose argv/environ macOS
    refuses to hand out at all, and it is given an empty environment so there is
    no inherited token to read even where reading is permitted. It then leaves
    the process group with ``setsid``.

    That leaves exactly one thing still true about it: it had a parent. Only
    descendant *observation* can find it (#2309, cycle 2).
    """
    sleeper = shutil.which("sleep") or "/bin/sleep"
    grandchild = subprocess.Popen(
        [sleeper, "30"],
        env={},
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    pidfile = os.environ.get("FAKE_GRANDCHILD_PID_FILE")
    if pidfile:
        with open(pidfile, "w") as fh:
            fh.write(str(grandchild.pid))
    # Keep working for a moment, the way an agent that kicked off a test run
    # does. The tracker samples every 50ms; a CLI that spawned and exited in the
    # same millisecond would be testing a race the OS itself cannot close on
    # macOS, not the leak this covers.
    time.sleep(0.4)


def main() -> None:
    if MODE == "unreadable_escapee_success":
        _read_user_msg()
        _spawn_unreadable_escapee()
        _emit(_RESULT_EVENT)
        sys.exit(0)

    if MODE == "escapee_success":
        # Succeed normally, having started work that is no longer in our group.
        _read_user_msg()
        _spawn_grandchild(detach_io=True, own_session=True)
        _emit(_RESULT_EVENT)
        sys.exit(0)

    if MODE == "grandchild_success":
        # Succeed normally while leaving live work behind — the shape of a dev
        # agent that ran `pytest -n auto` and returned before the workers did.
        _read_user_msg()
        _spawn_grandchild(detach_io=True)
        _emit(_RESULT_EVENT)
        sys.exit(0)

    if MODE == "grandchild_hang":
        _spawn_grandchild_and_hang()

    if MODE == "grandchild_stream":
        _spawn_grandchild_and_hang(stream_first=True)

    if MODE == "silent_stdout_close":
        # The #2832 shape: produce nothing at all, close stdout so the runner's
        # stream loop reaches EOF straight away, then stay alive past the
        # runner's post-stream exit grace. The runner sees zero lines, then its
        # bounded wait expires, then it SIGKILLs its own group — which is what
        # writes exit=-9 / $0.000 / 0 chars into the record.
        os.close(sys.stdout.fileno())
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            time.sleep(0.1)
        sys.exit(0)

    if MODE == "hang":
        # Consume initial prompt but never produce output; sleep until killed.
        # Uses a short-sleep loop capped at 3s so the test stays under the 5s
        # limit even if the watchdog regresses, without any single sleep > 1s.
        _read_user_msg()
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline:
            time.sleep(0.1)
        sys.exit(0)

    if MODE == "happy":
        _read_user_msg()
        _emit(_RESULT_EVENT)
        sys.exit(0)

    if MODE == "usage_then_hang":
        # Emit real per-message usage, then never emit a result event and hang
        # so the watchdog kills us. The runner must price what it saw.
        _read_user_msg()
        _emit(
            {
                "type": "assistant",
                "message": {
                    "role": "assistant",
                    "model": "claude-sonnet-4-6",
                    "content": [],
                    "usage": {
                        "input_tokens": 1000,
                        "output_tokens": 2000,
                        "cache_read_input_tokens": 500,
                        "cache_creation_input_tokens": 100,
                    },
                },
            }
        )
        sys.stdout.flush()
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            time.sleep(0.1)
        sys.exit(0)

    if MODE == "wait_stdin":
        # Emit result event then block on stdin WITHOUT closing stdout.
        # Stdout stays open so the runner's for-loop cannot exit by seeing EOF —
        # it can only exit by breaking on the result event (the fix for #1054).
        # Without the break-on-result fix the loop blocks, the watchdog fires
        # after the timeout, and the result is a kill-failure even though the
        # result event was captured. With the fix the loop exits early, stdin is
        # closed, and this subprocess unblocks and exits cleanly with code 0.
        _read_user_msg()
        _emit(_RESULT_EVENT)
        sys.stdout.flush()
        # Block until runner closes our stdin (EOF); stdout intentionally open.
        sys.stdin.read()
        sys.exit(0)

    if MODE == "nudge":
        # Emit two identical tool-use iterations so the runner's stuck-detection
        # fires a nudge after the second (repeat_threshold=2 in the test profile).
        # Then read the nudge from stdin and respond with a result event.
        # Sequence:
        #   subprocess emits 4 lines → runner reads them → nudge sent to stdin
        #   subprocess reads nudge → emits result line → exits
        _read_user_msg()
        _emit_tool_iteration()  # iteration 1: _repeat_count rises to 1
        _emit_tool_iteration()  # iteration 2: _repeat_count reaches 2, nudge fires
        sys.stdout.flush()
        # Wait for the nudge message the runner writes to our stdin.
        _read_user_msg()
        _emit(_RESULT_EVENT)
        sys.exit(0)

    # Unknown mode — exit non-zero so tests see it immediately.
    sys.stderr.write(f"fake claude: unknown FAKE_CLAUDE_MODE={MODE!r}\n")
    sys.exit(1)


main()
