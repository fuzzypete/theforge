#!/usr/bin/env python3
"""Fake npx CLI for runner lifecycle subprocess tests.

Routes to fake codex or gemini behaviour based on the package argument.

Codex (FAKE_CODEX_MODE):
  happy         — write "Task complete." to the -o output file, exit 0 (default)
  json_usage    — emit the `codex exec --json` JSONL event stream (thread.started,
                  item.completed agent_message, turn.completed with a real token
                  usage split incl. cached/cache-write/reasoning) on stdout AND
                  write the last message to -o, exit 0
  json_two_turns
                — like json_usage but with TWO turn.completed events, so tests can
                  pin how multi-turn usage is accumulated
  json_no_output_file
                — emit the JSONL event stream but leave -o empty, so the runner
                  must reconstruct agent text from the events rather than dumping
                  raw JSONL into handoff/review parsing
  json_partial_hang
                — emit a turn.completed usage event, flush, then hang past the
                  runner timeout, so the killed-run partial-cost path can be
                  exercised end to end
  usage         — write a JSON blob with a token `usage` block to the -o file
  usage_stdout  — write plain text to the -o file, print a SINGLE-LINE token
                  summary carrying an input+output split to stdout (a synthetic
                  structured-style summary that exercises the stdout-scan cost
                  path; the real CLI's human output is total-only, see below)
  total_only    — write plain text to the -o file, print the REAL Codex CLI
                  v0.142.x human summary (a bare `tokens used` total, no split)
                  to stdout, so tests can assert it is recorded cost-unknown
                  rather than fabricating a cost from a total alone
  git_trust_gate — mimic the real CLI's trust gate: refuse with codex's own
                  "Not inside a trusted directory" stderr and exit 1 UNLESS
                  --skip-git-repo-check was passed; with the flag, behave like
                  json_usage. Proves forge can run codex in the .git-less
                  git-archive baseline checkout (#2164).
  model_refused — mimic a provider refusal issued BEFORE generation: the turn
                  starts, then the provider returns an immediate HTTP 400
                  invalid_request_error for an unsupported model, and the CLI
                  exits 1 with no usage anywhere (#2913). Nothing was billed.
  upstream_error — the same shape but with an unmeasurable failure: the turn
                  starts and fails on an upstream 500, which could have consumed
                  tokens and so must stay cost-unknown
  launch_refusal — always refuse at launch (deprecation warning + trust-gate
                  stderr, exit 1, no JSONL events at all), so the pre-turn
                  launch-failure classification can be exercised
  grandchild_hang
                — spawn a long-sleeping grandchild in the same process group
                  (mirroring npm→node→codex), write its PID to
                  $FAKE_GRANDCHILD_PID_FILE, then hang past the runner timeout.
                  Proves the group kill reaches past `npm exec` to the leaf.
  grandchild_success
                — spawn the same grandchild but then succeed normally and exit 0,
                  so only a teardown that checks the group on a CLEAN exit reaps
                  it (#2309).
  escapee_success
                — like grandchild_success, but the grandchild starts its own
                  session (setsid) and so leaves the process group entirely, so
                  only descendant observation or the lease token reaches it (#2309).
  unreadable_escapee_success
                — the hardest shape: a SIP-protected platform binary given an
                  EMPTY environment and its own session, so neither the group nor
                  any token can find it — only descendant observation (#2309).

Gemini (FAKE_GEMINI_MODE):
  happy  — print {"response": "Task complete."} to stdout, exit 0 (default)
  grandchild_success
         — spawn a long-sleeping grandchild in the same process group, record its
           PID in $FAKE_GRANDCHILD_PID_FILE, then print the happy JSON and exit 0
  escapee_success
         — same, but the grandchild starts its own session and leaves the group
  unreadable_escapee_success
         — a SIP-protected binary with an empty environment in its own session
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time

args = sys.argv[1:]


def _spawn_grandchild(detach_io: bool = False, own_session: bool = False) -> None:
    """Spawn a sleeping grandchild in this process group and record its PID.

    ``detach_io`` closes the grandchild off from our stdout/stderr, which the
    clean-exit modes need: a grandchild holding the capture pipe keeps the
    runner's ``communicate()`` blocked until the timeout, which would turn a
    clean-exit test into a timeout test and prove nothing about #2309.

    ``own_session`` makes it leave the process group (setsid), the way a test
    runner or a daemonising helper does — the escape a pgid cannot describe.
    """
    io = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL} if detach_io else {}
    grandchild = subprocess.Popen(
        [sys.executable, "-c", "import time; time.sleep(30)"],
        start_new_session=own_session,
        **io,
    )
    pidfile = os.environ.get("FAKE_GRANDCHILD_PID_FILE")
    if pidfile:
        with open(pidfile, "w") as fh:
            fh.write(str(grandchild.pid))
    if own_session:
        # An escapee is only findable by the two mechanisms that survive setsid,
        # and one of them (descendant observation) needs the CLI to still be
        # alive when it samples. Keeping working for a moment is what a dev agent
        # that kicked off a test run does; spawning and exiting in the same
        # millisecond would test a race the OS itself cannot close on macOS.
        time.sleep(0.4)


def _spawn_unreadable_escapee() -> None:
    """Spawn a descendant that no environment token can ever find.

    Two hardenings at once, both of them ordinary rather than adversarial:
    ``/bin/sleep`` is a SIP-protected platform binary, whose argv/environ macOS
    refuses to hand out at all, and it is given an empty environment so there is
    no inherited token to read even where reading is permitted. It then leaves
    the process group with ``setsid``.

    That leaves exactly one thing still true about it: it had a parent. Only
    descendant *observation* can find it (#2309, cycle 2).
    """
    sleeper = shutil.which("sleep") or "/bin/sleep"
    grandchild = subprocess.Popen(
        [sleeper, "30"],
        env={},
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    pidfile = os.environ.get("FAKE_GRANDCHILD_PID_FILE")
    if pidfile:
        with open(pidfile, "w") as fh:
            fh.write(str(grandchild.pid))
    # Keep working for a moment, the way an agent that kicked off a test run
    # does. The tracker samples every 50ms; a CLI that spawned and exited in the
    # same millisecond would be testing a race the OS itself cannot close on
    # macOS, not the leak this covers.
    time.sleep(0.4)


def _find_flag(flag: str) -> str | None:
    """Return the value immediately following *flag* in args, or None."""
    for i, a in enumerate(args):
        if a == flag and i + 1 < len(args):
            return args[i + 1]
    return None


if any(a.startswith("@openai/codex") for a in args):
    mode = os.environ.get("FAKE_CODEX_MODE", "happy")
    output_file = _find_flag("-o")
    if mode == "happy":
        output_text = "Task complete."
        if output_file:
            with open(output_file, "w") as fh:
                fh.write(output_text + "\n")
        else:
            print(output_text)
        sys.exit(0)
    # Token split mirroring a real `codex exec --json` turn.completed event:
    # cached_input_tokens is a SUBSET of input_tokens, reasoning_output_tokens a
    # SUBSET of output_tokens.
    _TURN_USAGE = {
        "input_tokens": 12892,
        "cached_input_tokens": 9088,
        "cache_write_input_tokens": 256,
        "output_tokens": 2100,
        "reasoning_output_tokens": 1400,
    }

    def _emit_events(turns=1, agent_text="Task complete."):
        print(json.dumps({"type": "thread.started", "thread_id": "th_fake"}))
        print(
            json.dumps(
                {
                    "type": "item.completed",
                    "item": {"id": "i1", "type": "agent_message", "text": agent_text},
                }
            )
        )
        for _ in range(turns):
            print(json.dumps({"type": "turn.completed", "usage": dict(_TURN_USAGE)}))
        sys.stdout.flush()

    if mode in ("json_usage", "json_two_turns", "json_no_output_file", "json_partial_hang"):
        # Event mode only exists because forge asked for it. Fail loudly rather
        # than emitting JSONL a real CLI would not have produced.
        if "--json" not in args:
            sys.stderr.write("fake npx(codex): event mode requested without --json\n")
            sys.exit(2)
    if mode in ("json_usage", "json_two_turns", "json_no_output_file"):
        if output_file and mode != "json_no_output_file":
            with open(output_file, "w") as fh:
                fh.write("Task complete.\n")
        _emit_events(turns=2 if mode == "json_two_turns" else 1)
        sys.exit(0)
    if mode == "json_partial_hang":
        _emit_events(turns=1)
        # Hang past the runner timeout so the kill path fires with usage already
        # on the wire.
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            time.sleep(0.1)
        sys.exit(0)
    if mode in ("model_refused", "upstream_error"):
        if "--json" not in args:
            sys.stderr.write("fake npx(codex): event mode requested without --json\n")
            sys.exit(2)
        print(json.dumps({"type": "thread.started", "thread_id": "th_fake"}))
        print(json.dumps({"type": "turn.started"}))
        if mode == "model_refused":
            # Verbatim shape of the provider's pre-generation refusal (#2913).
            print(
                json.dumps(
                    {
                        "type": "error",
                        "status": 400,
                        "error": {
                            "type": "invalid_request_error",
                            "message": (
                                "The 'gpt-5.4' model is not supported when using "
                                "Codex with a ChatGPT account."
                            ),
                        },
                    }
                )
            )
        else:
            print(json.dumps({"type": "turn.failed", "error": {"message": "upstream 500"}}))
        sys.stdout.flush()
        sys.exit(1)
    if mode in ("git_trust_gate", "launch_refusal"):
        # The real refusal, verbatim from Codex CLI v0.14x, preceded by the
        # deprecation notice it emits first (see #2164's captured stderr).
        if mode == "launch_refusal" or "--skip-git-repo-check" not in args:
            sys.stderr.write(
                "warning: `--full-auto` is deprecated; use `--sandbox workspace-write` instead.\n"
            )
            sys.stderr.write("Reading additional input from stdin...\n")
            sys.stderr.write(
                "Not inside a trusted directory and --skip-git-repo-check was not specified.\n"
            )
            sys.exit(1)
        if output_file:
            with open(output_file, "w") as fh:
                fh.write("Task complete.\n")
        _emit_events(turns=1)
        sys.exit(0)
    if mode == "usage":
        blob = {
            "result": "Task complete.",
            "usage": {"input_tokens": 1000, "output_tokens": 500},
        }
        if output_file:
            with open(output_file, "w") as fh:
                fh.write(json.dumps(blob) + "\n")
        else:
            print(json.dumps(blob))
        sys.exit(0)
    if mode == "usage_stdout":
        if output_file:
            with open(output_file, "w") as fh:
                fh.write("Task complete.\n")
        print("tokens used: input 1,000 output 500")
        sys.exit(0)
    if mode == "total_only":
        if output_file:
            with open(output_file, "w") as fh:
                fh.write("hi\n")
        # Real Codex CLI v0.142.x human summary: a bare total on its own line.
        print("tokens used")
        print("11,374")
        sys.exit(0)
    if mode == "unreadable_escapee_success":
        _spawn_unreadable_escapee()
        if output_file:
            with open(output_file, "w") as fh:
                fh.write("Task complete.\n")
        else:
            print("Task complete.")
        sys.exit(0)
    if mode in ("grandchild_success", "escapee_success"):
        # Succeed normally while leaving live work behind — only a teardown that
        # checks the group on a CLEAN exit reaps the grandchild, and only the
        # lease reaches it once it has left the group (#2309).
        _spawn_grandchild(detach_io=True, own_session=mode == "escapee_success")
        output_text = "Task complete."
        if output_file:
            with open(output_file, "w") as fh:
                fh.write(output_text + "\n")
        else:
            print(output_text)
        sys.exit(0)
    if mode == "grandchild_hang":
        _spawn_grandchild()
        # Hang past the runner timeout so the group-kill path fires.
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            time.sleep(0.1)
        sys.exit(0)
    sys.stderr.write(f"fake npx(codex): unknown FAKE_CODEX_MODE={mode!r}\n")
    sys.exit(1)

elif "@google/gemini-cli" in args:
    mode = os.environ.get("FAKE_GEMINI_MODE", "happy")
    if mode == "unreadable_escapee_success":
        _spawn_unreadable_escapee()
        print(json.dumps({"response": "Task complete."}))
        sys.exit(0)
    if mode in ("grandchild_success", "escapee_success"):
        _spawn_grandchild(detach_io=True, own_session=mode == "escapee_success")
        print(json.dumps({"response": "Task complete."}))
        sys.exit(0)
    if mode == "happy":
        print(json.dumps({"response": "Task complete."}))
        sys.exit(0)
    sys.stderr.write(f"fake npx(gemini): unknown FAKE_GEMINI_MODE={mode!r}\n")
    sys.exit(1)

else:
    sys.stderr.write(f"fake npx: unrecognised package in args: {args!r}\n")
    sys.exit(1)
