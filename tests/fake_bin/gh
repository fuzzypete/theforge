#!/usr/bin/env python3
"""Fake gh CLI for runner_ghaw lifecycle subprocess tests.

Controlled via FAKE_GH_MODE environment variable:
  happy           — dispatch succeeds, run appears, completes with success,
                    artifacts download (default)
  dispatch_fail   — `gh workflow run` exits 1 with an error on stderr
  never_completes — run appears but `gh run view` always reports in_progress
                    (drives the runner's wall-clock timeout path)
  run_fail        — run completes with conclusion=failure
  list_empty      — `gh run list` never shows the dispatched run
                    (drives the discovery-timeout path)

State (the dispatch id) is passed between invocations via a file in
FAKE_GH_STATE_DIR, since each gh call is a separate process.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

MODE = os.environ.get("FAKE_GH_MODE", "happy")
STATE_DIR = Path(os.environ.get("FAKE_GH_STATE_DIR", "."))
RUN_ID = 4242


def _dispatch_id() -> str:
    try:
        return (STATE_DIR / "dispatch_id").read_text().strip()
    except OSError:
        return "unknown"


def main() -> int:
    args = sys.argv[1:]

    if args[:2] == ["workflow", "run"]:
        if MODE == "dispatch_fail":
            print("could not create workflow dispatch event: HTTP 422", file=sys.stderr)
            return 1
        for arg in args:
            if arg.startswith("dispatch_id="):
                (STATE_DIR / "dispatch_id").write_text(arg.split("=", 1)[1])
        return 0

    if args[:2] == ["run", "list"]:
        if MODE == "list_empty":
            print("[]")
            return 0
        print(
            json.dumps(
                [
                    {
                        "databaseId": RUN_ID,
                        "displayTitle": f"forge-dev-ghaw {_dispatch_id()}",
                        "status": "in_progress",
                        "conclusion": "",
                        "createdAt": "2026-07-16T00:00:00Z",
                    }
                ]
            )
        )
        return 0

    if args[:2] == ["run", "view"]:
        status = "in_progress" if MODE == "never_completes" else "completed"
        conclusion = ""
        if status == "completed":
            conclusion = "failure" if MODE == "run_fail" else "success"
        print(
            json.dumps(
                {
                    "databaseId": RUN_ID,
                    "status": status,
                    "conclusion": conclusion,
                    "createdAt": "2026-07-16T00:00:00Z",
                    "startedAt": "2026-07-16T00:00:30Z",
                    "updatedAt": "2026-07-16T00:05:00Z",
                    "url": f"https://github.com/example/repo/actions/runs/{RUN_ID}",
                }
            )
        )
        return 0

    if args[:2] == ["run", "download"]:
        dest = Path(args[args.index("--dir") + 1])
        out_dir = dest / "agent-output"
        out_dir.mkdir(parents=True, exist_ok=True)
        (out_dir / "agent-output.md").write_text(
            "Fake ghaw agent output: task complete.\n"
        )
        return 0

    if args[:2] == ["run", "cancel"]:
        return 0

    print(f"fake gh: unhandled argv {args!r}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
